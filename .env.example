# Shared PostgreSQL Connection parameters (Supabase instance)
DATABASE_URL="postgresql://postgres.your-supabase-db:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.your-supabase-db:5432/postgres"

# NextAuth Authentication Config
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"
WEBHOOK_URL="http://localhost:3000"
ADMIN_PHONE="your_admin_phone"
ADMIN_EMAILS="owner@example.com"

# Google OAuth API Credentials (optional)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Stripe pack credit purchases configurations (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# ============================================================
# 阿里云百炼 · 千问（OpenAI 兼容接口）—— 必须使用新建且未泄露的 Key
# ============================================================
QWEN_API_KEY="your_new_qwen_api_key_here"
QWEN_BASE_URL="https://ws-pbsy3glg6282g3o0.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
QWEN_VISION_MODEL="qwen3.5-omni-plus"
QWEN_IMAGE_MODEL="qwen-image-3.0"

# ============================================================
# 火山方舟 · 豆包（Seedream 图片生成 / SeedEdit 编辑）
# 方舟 API Key 可直接调用已开通的公开 Model ID；也可以填自定义 Endpoint ID。
# 使用公开模型前需确认该模型已在此账号开通。
# ============================================================
# 旧账号：继续用于图片生成
ARK_API_KEY="your_ark_image_api_key_here"
# 新账号：视觉诊断专用；留空时兼容复用 ARK_API_KEY
ARK_VISION_API_KEY="your_ark_vision_api_key_here"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# 旧版单模型兼容项；这里填公开 Model ID 或 Endpoint ID。
ARK_IMAGE_MODEL="doubao-seedream-5-0-pro-260628"
# 普通档用成本更低的 Flash；高档/旗舰档及编辑继续用 Pro。
ARK_IMAGE_MODEL_FLASH="doubao-seedream-5-0-flash-260915"
ARK_IMAGE_MODEL_PRO="doubao-seedream-5-0-pro-260628"
# 视觉诊断使用 Doubao Seed 2.1 Lite，兼顾图像理解能力与调用成本。
ARK_VISION_MODEL="doubao-seed-2-1-lite-260915"

# 当前默认全走豆包。仅在明确切换供应商时改对应值；fallback 留空即关闭。
AI_STANDARD_IMAGE_PROVIDER="ark"
AI_HIGH_IMAGE_PROVIDER="ark"
AI_FLAGSHIP_IMAGE_PROVIDER="ark"
AI_EDIT_IMAGE_PROVIDER="ark"
AI_VISION_PROVIDER="ark"

# 服务订单付款成功后的微信交付信息（公开展示，不填写则页面提示管理员配置）
NEXT_PUBLIC_SERVICE_WECHAT="your_service_wechat_contact"
NEXT_PUBLIC_SERVICE_WECHAT_QR_URL="/service-wechat-qr.jpg"

# 人脸照片在服务器本地的保留时长（小时），到期自动清理
UPLOAD_TTL_HOURS=24
IMAGE_STORAGE_DIR="./.data"
