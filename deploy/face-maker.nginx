server {
    listen 80;
    listen [::]:80;
    server_name face.shuqizhisou.cc;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    # Nginx 1.18 on the production host supports HTTP/2 via the listen flag.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name face.shuqizhisou.cc;

    ssl_certificate /etc/letsencrypt/live/face.shuqizhisou.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/face.shuqizhisou.cc/privkey.pem;

    # 不泄露版本信息，并要求浏览器后续全程走 HTTPS
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 20M;

    # Route user media through Next.js so account and published-post access checks run.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
